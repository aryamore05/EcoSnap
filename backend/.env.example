# EcoSnap Backend Environment Configuration

# --- AI / Ollama settings ---

# Ollama server URL (default: http://localhost:11434)
# Ollama must be installed and running:  ollama serve
OLLAMA_URL=http://localhost:11434

# Vision-capable model name (MUST support images, not text-only)
# Default: llava:7b  — open-weight vision-language model
# Pull it before first use:  ollama pull llava:7b
# Alternative: llava:13b (higher quality, needs more RAM/GPU)
# Alternative: llava-llama3 (newer, if available in your Ollama version)
OLLAMA_MODEL=llava:7b

# Set to "true" ONLY for testing the frontend without Ollama installed.
# When true, /analyze returns a clearly-labelled demo result (no real AI).
# When false, /analyze calls the real Ollama vision model.
DEMO_MODE=false

# --- Backend settings ---

# SQLite database file path (used for local backup / tests)
DATABASE_PATH=ecosnap.db

# Temporary upload directory (images are NOT stored permanently)
UPLOAD_DIR=uploads

# CORS origins — comma-separated, use * to allow all
CORS_ORIGINS=*
